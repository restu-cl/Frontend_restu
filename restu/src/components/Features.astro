<section id="funciones" class="rl-cream scroll-mt-[72px] py-20">
  <div class="mx-auto max-w-[1240px] px-6">
    <div data-reveal="up" class="text-center max-w-[680px] mx-auto mb-14">
      <span class="inline-block text-[11px] font-bold tracking-[.18em] uppercase text-[#b85527] mb-3">Todo lo que necesitas</span>
      <h2 class="text-[clamp(26px,3.8vw,42px)] font-extrabold tracking-[-0.022em] leading-[1.1] text-[#1a1a1a]">
        Una sola plataforma.<br/>Cero integraciones.
      </h2>
      <p class="mt-3.5 text-[16px] text-[#525252] leading-[1.55]">Desde que tu cliente escanea el QR hasta que el pedido sale por la puerta.</p>
    </div>

    {/* Core 4 */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {[
        {
          icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>`,
          title: 'Menú Digital QR',
          desc: 'Carta siempre al día con fotos, modificadores y stock actualizado. Sin apps.',
        },
        {
          icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>`,
          title: 'Pantalla de Cocina (KDS)',
          desc: 'Tickets digitales con cronómetro por pedido. Estaciones independientes, sin papel.',
        },
        {
          icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
          title: 'Reparto Integrado',
          desc: 'Zonas, tarifas y tiempos de entrega. Asigna repartidor propio o externo.',
        },
        {
          icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
          title: 'Métricas en Vivo',
          desc: 'Ventas, ticket promedio, tops del día y márgenes. Reportes que realmente usarías.',
        },
      ].map(({ icon, title, desc }, i) => (
        <article data-reveal="up" style={`transition-delay: ${i * 0.09}s`}
          class="rl-ft bg-white rounded-[18px] border border-[#eee5d3] p-6 flex flex-col gap-3 transition-all duration-200">
          <span class="w-[46px] h-[46px] rounded-[12px] flex items-center justify-center flex-shrink-0 text-[#b85527]"
            style="background: linear-gradient(135deg, rgba(222, 107, 53, .14), rgba(255, 135, 83, .06))" set:html={icon} aria-hidden="true"/>
          <h3 class="text-[16px] font-bold tracking-[-0.01em] text-[#1a1a1a]">{title}</h3>
          <p class="text-[13.5px] text-[#525252] leading-[1.55]">{desc}</p>
        </article>
      ))}
    </div>

    {/* Advanced 3 */}
    <div class="mt-4">
      <div data-reveal="up" class="flex items-center gap-3 mb-4">
        <span class="text-[11px] font-bold tracking-[.14em] uppercase text-[#5f5f5f] whitespace-nowrap">Funciones avanzadas</span>
        <div class="flex-1 h-px bg-[#eee5d3]"/>
      </div>
      <div id="variance-section" class="grid grid-cols-1 md:grid-cols-3 gap-4">

        {/* VARIANZA */}
        <div data-reveal="up" style="transition-delay: .05s"
          class="rl-adv bg-white rounded-[18px] border border-[#eee5d3] p-6 flex flex-col gap-4 transition-all duration-200">
          <div class="flex items-center gap-3">
            <span class="w-[42px] h-[42px] rounded-[11px] flex items-center justify-center flex-shrink-0"
              style="background: rgba(245, 177, 59, .12); color: #c88a00" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="5" x2="6" y2="19"/><path d="M6 5h12v12"/>
              </svg>
            </span>
            <div>
              <strong class="block text-[15.5px] font-bold text-[#1a1a1a] tracking-tight">Control de Varianza</strong>
              <span class="text-[12px] text-[#525252]">Detección de merma oculta</span>
            </div>
          </div>
          <p class="text-[13.5px] text-[#525252] leading-[1.55]">
            Compara lo que debería haber en bodega (según recetas vendidas) con el stock real.
            Detecta mermas, fugas y errores antes de que duelan en el margen.
          </p>
          <div id="variance-chart" class="rounded-[11px] p-3 flex flex-col gap-2" style="background: #f8f8f8">
            {[
              { lbl: 'Harina (kg)', target: '92%', cls: 'bg-[#4ade80]', diff: '+2%', ok: true, delay: '.1s' },
              { lbl: 'Queso gouda', target: '68%', cls: 'bg-[#fb923c]', diff: '−14%', ok: false, delay: '.25s' },
              { lbl: 'Lomo vetado', target: '43%', cls: 'bg-[#f87171]', diff: '−31%', ok: false, delay: '.4s' },
            ].map(r => (
              <div class="flex items-center gap-2 text-[11.5px]">
                <span class="w-[90px] flex-shrink-0 text-[11px] text-[#525252] font-medium">{r.lbl}</span>
                <div class="flex-1 h-3 rounded-md overflow-hidden bg-[#e5e7eb]">
                  <div class={`rl-vbar h-full rounded-md ${r.cls}`} style={`width: 0%; transition-delay: ${r.delay}`}/>
                </div>
                <span class="w-10 text-right text-[10.5px] font-bold" style={`color: ${r.ok ? '#15803d' : r.target === '68%' ? '#b45309' : '#b91c1c'}`}>{r.diff}</span>
              </div>
            ))}
          </div>
        </div>

        {/* TRAZABILIDAD LOTES */}
        <div data-reveal="up" style="transition-delay: .14s"
          class="rl-adv bg-white rounded-[18px] border border-[#eee5d3] p-6 flex flex-col gap-4 transition-all duration-200">
          <div class="flex items-center gap-3">
            <span class="w-[42px] h-[42px] rounded-[11px] flex items-center justify-center flex-shrink-0"
              style="background: rgba(59, 130, 246, .1); color: #2563eb" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="7" width="20" height="14" rx="2"/>
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                <line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/>
              </svg>
            </span>
            <div>
              <strong class="block text-[15.5px] font-bold text-[#1a1a1a] tracking-tight">Trazabilidad de Lotes</strong>
              <span class="text-[12px] text-[#525252]">FIFO automático y vencimientos</span>
            </div>
          </div>
          <p class="text-[13.5px] text-[#525252] leading-[1.55]">
            Registra cada compra como un lote con fecha de vencimiento. Restu descuenta siempre
            del lote más antiguo (FIFO) y te avisa antes de que algo expire.
          </p>
          <div class="rounded-[11px] overflow-hidden text-[10.5px]" style="background: #f8f8f8">
            <div class="grid px-3 py-1.5 text-[9.5px] font-bold uppercase tracking-[.08em] text-[#5f5f5f]"
              style="grid-template-columns: 1.5fr 1fr 1fr; background: #eee5d3">
              <span>Insumo</span><span>Vence</span><span>Estado</span>
            </div>
            {[
              { n: 'Salmón — L‑042', d: '28 may', s: 'OK', c: 'bg-[#dcfce7] text-[#15803d]' },
              { n: 'Crema — L‑038', d: '31 may', s: 'Pronto', c: 'bg-[#fef3c7] text-[#92400e]' },
              { n: 'Camarón — L‑031', d: '25 may', s: 'Vence hoy', c: 'bg-[#fee2e2] text-[#b91c1c]' },
            ].map(r => (
              <div class="grid px-3 py-1.5 border-t border-[#eee5d3]" style="grid-template-columns: 1.5fr 1fr 1fr">
                <span class="font-semibold text-[#1a1a1a]">{r.n}</span>
                <span class="text-[#525252]">{r.d}</span>
                <span class={`inline-flex items-center px-2 py-0.5 rounded-full font-bold text-[9px] tracking-[.04em] ${r.c}`}>{r.s}</span>
              </div>
            ))}
          </div>
        </div>

        {/* AVISOS AUTOMATIZADOS */}
        <div data-reveal="up" style="transition-delay: .23s"
          class="rl-adv bg-white rounded-[18px] border border-[#eee5d3] p-6 flex flex-col gap-4 transition-all duration-200">
          <div class="flex items-center gap-3">
            <span class="w-[42px] h-[42px] rounded-[11px] flex items-center justify-center flex-shrink-0"
              style="background: rgba(222, 107, 53, .12); color: #DE6B35" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              </svg>
            </span>
            <div>
              <strong class="block text-[15.5px] font-bold text-[#1a1a1a] tracking-tight">Avisos Automatizados</strong>
              <span class="text-[12px] text-[#525252]">Pedidos entrantes y alertas ROP</span>
            </div>
          </div>
          <p class="text-[13.5px] text-[#525252] leading-[1.55]">
            Aviso sonoro y visual al entrar cada pedido. Cuando un insumo cae bajo su Punto
            de Reorden (ROP), Restu te alerta antes de quedarte sin stock.
          </p>
          <div class="flex flex-col gap-2">
            {[
              { emoji: '🛒', title: 'Nuevo pedido #028', sub: 'Pizza Margherita + Coca‑Cola · Delivery', time: 'ahora', c: 'border-[#DE6B35]', bg: 'bg-[#fff9f5]' },
              { emoji: '⚠️', title: 'Bajo ROP: Harina (5 kg)', sub: 'Mínimo recomendado: 10 kg. Reabastecer pronto.', time: '3 min', c: 'border-[#f59e0b]', bg: 'bg-[#fffbf0]' },
              { emoji: '✅', title: 'Orden #027 entregada', sub: 'Cliente: María G. · Pago confirmado.', time: '9 min', c: 'border-[#16a34a]', bg: 'bg-[#f0fdf4]' },
            ].map(n => (
              <div class={`flex items-start gap-2.5 rounded-[10px] px-3 py-2.5 border-l-[3px] ${n.c} ${n.bg}`}>
                <span class="text-[14px] flex-shrink-0 mt-0.5">{n.emoji}</span>
                <span class="flex-1 min-w-0">
                  <strong class="block text-[12px] font-bold text-[#1a1a1a]">{n.title}</strong>
                  <span class="text-[11px] text-[#525252]">{n.sub}</span>
                </span>
                <span class="text-[10px] text-[#5f5f5f] flex-shrink-0 pt-0.5">{n.time}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  const varSection = document.getElementById('variance-section');
  if (varSection) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) {
        const bars = varSection.querySelectorAll('.rl-vbar');
        const targets = ['92%', '68%', '43%'];
        bars.forEach((bar, i) => {
          setTimeout(() => {
            (bar as HTMLElement).style.width = targets[i];
          }, i * 150);
        });
        io.disconnect();
      }
    }, { threshold: 0.25 });
    io.observe(varSection);
  }
</script>