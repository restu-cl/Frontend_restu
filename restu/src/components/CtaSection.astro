---
interface Props {
  onEnter?: string;
}

const { onEnter = '/' } = Astro.props;
---

<section class="py-20">
  <div class="mx-auto max-w-[1240px] px-6">
    <div data-reveal="scale" class="relative rounded-[28px] px-8 py-16 text-center text-white overflow-hidden"
      style="background: linear-gradient(135deg, #DE6B35, #c95c2a)">
      <div class="pointer-events-none absolute -top-[90px] -right-[70px] w-[260px] h-[260px] rounded-full"
        style="background: rgba(255, 255, 255, .08); filter: blur(55px)"/>
      <div class="pointer-events-none absolute -bottom-[90px] -left-[70px] w-[260px] h-[260px] rounded-full"
        style="background: rgba(255, 255, 255, .08); filter: blur(55px)"/>
      <h2 class="relative text-[clamp(24px, 3.2vw, 38px)] font-extrabold tracking-[-0.02em] max-w-[640px] mx-auto leading-[1.1]">
        ¿Listo para recuperar el control?<br/>Prueba Restu gratis hoy.
      </h2>
      <p class="relative mt-4 text-[16px] max-w-[480px] mx-auto leading-[1.55]" style="color: rgba(255, 255, 255, 1)">
        Te configuramos tu carta digital en una llamada de 15 minutos. Sin tarjeta de crédito.
      </p>
      <a href={onEnter}
        class="relative mt-8 inline-flex items-center gap-2 bg-white text-[#b85527] hover:text-[#a94e22] text-[16px] font-bold rounded-xl px-8 py-4 transition-all hover:scale-[1.03] active:scale-[.98] no-underline"
        style="box-shadow: 0 12px 28px -10px rgba(0, 0, 0, .28)">
        Solicita una Demo Gratis
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>