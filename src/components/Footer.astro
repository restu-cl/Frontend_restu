---
interface Props {
  onEnter?: string;
}

const { onEnter = '/' } = Astro.props;

const NAV = [
  { label: 'Cómo funciona', id: 'como-funciona' },
  { label: 'Comparativa', id: 'comparativa' },
  { label: 'Funciones', id: 'funciones' },
  { label: 'Precio', id: 'precio' },
];
---

<footer class="border-t border-[#eee5d3] py-8">
  <div class="mx-auto max-w-[1240px] px-6 flex flex-col sm:flex-row items-center justify-between gap-4 flex-wrap">
    <a href="/" class="flex items-center gap-2 group" aria-label="Restu - Ir al inicio">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#DE6B35"/>
        <path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="text-[17px] font-bold tracking-tight text-[#1a1a1a] group-hover:text-[#b85527] transition-colors">restu</span>
    </a>
    <nav class="flex items-center gap-5 text-[13px] text-[#5f5f5f]" aria-label="Navegación del pie de página">
      {NAV.map(n => (
        <button data-scroll-to={n.id}
          class="hover:text-[#1a1a1a] transition-colors cursor-pointer py-1.5">
          {n.label}
        </button>
      ))}
    </nav>
    <p class="text-[13px] text-[#5f5f5f]">© {new Date().getFullYear()} Restu · Santiago, Chile</p>
  </div>
</footer>