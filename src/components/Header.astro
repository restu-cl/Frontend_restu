---
interface Props {
  onEnter?: string;
}

const { onEnter = '/' } = Astro.props;

const NAV = [
  { label: 'Cómo funciona', id: 'como-funciona' },
  { label: 'Comparativa', id: 'comparativa' },
  { label: 'Precio', id: 'precio' },
  { label: 'Funciones', id: 'funciones' },
];
---

<header class="rl-nav w-full">
  <div class="mx-auto max-w-[1240px] px-6 h-[68px] flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 shrink-0 group" aria-label="Restu - Ir al inicio">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#DE6B35"/>
        <path d="M8 12h16M8 16h12M8 20h8" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="text-[21px] font-bold tracking-tight text-[#1a1a1a] group-hover:text-[#DE6B35] transition-colors">restu</span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
      {NAV.map(n => (
        <button data-scroll-to={n.id}
          class="px-4 py-2 text-[14px] text-[#525252] hover:text-[#1a1a1a] hover:bg-black/[.04] rounded-lg transition-colors font-medium cursor-pointer">
          {n.label}
        </button>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-2 shrink-0">
      <a href={onEnter}
        class="px-4 py-2 text-[14px] text-[#525252] hover:text-[#DE6B35] font-medium rounded-lg transition-colors">
        Iniciar sesión
      </a>
      <a href={onEnter}
        class="btn-p text-white text-[13px] font-semibold rounded-lg px-4 py-2.5 transition-all">
        Solicita una Demo
      </a>
    </div>

    <button id="mobile-menu-btn"
      class="md:hidden p-2 rounded-lg hover:bg-black/[.04] transition-colors text-[#525252] cursor-pointer"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú de navegación">
      <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-x" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="rl-mobile md:hidden" aria-label="Navegación móvil">
    <div class="border-t border-[#eee5d3] px-5 pb-5 pt-3 flex flex-col gap-1">
      {NAV.map(n => (
        <button data-scroll-to={n.id}
          class="text-left px-3 py-3 text-[15px] text-[#1a1a1a] hover:text-[#DE6B35] hover:bg-orange-50 rounded-xl transition-colors font-medium cursor-pointer">
          {n.label}
        </button>
      ))}
      <hr class="my-2 border-[#eee5d3]"/>
      <a href={onEnter}
        class="text-left px-3 py-3 text-[15px] text-[#1a1a1a] hover:text-[#DE6B35] font-medium rounded-xl hover:bg-orange-50 transition-colors">
        Iniciar sesión
      </a>
      <a href={onEnter}
        class="btn-p text-white text-[14px] font-semibold rounded-xl px-4 py-3 mt-1 transition-all text-center">
        Solicita una Demo Gratis
      </a>
    </div>
  </nav>
</header>